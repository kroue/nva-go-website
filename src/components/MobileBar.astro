---
/** Sticky bottom action bar on phones: Call, Messenger, Get a Quote. */
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<nav
  aria-label="Quick actions"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-paper md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom)"
>
  <ul class="grid h-16 grid-cols-3">
    <li>
      <a href={`tel:${site.phone.mobile.tel}`} class="flex h-full flex-col items-center justify-center gap-0.5 text-[0.8rem] font-bold">
        <Icon name="phone" class="size-5 text-cyan-ink" />
        Call
      </a>
    </li>
    <li>
      <a
        href={site.social.messenger}
        class="flex h-full flex-col items-center justify-center gap-0.5 border-x border-line text-[0.8rem] font-bold"
        rel="noopener"
      >
        <Icon name="messenger" class="size-5 text-magenta-ink" />
        Messenger
      </a>
    </li>
    <li>
      <a href="/quote/" class="flex h-full flex-col items-center justify-center gap-0.5 bg-ink text-[0.8rem] font-bold text-paper">
        <Icon name="quote" class="size-5 text-yellow" />
        Get a Quote
      </a>
    </li>
  </ul>
</nav>
