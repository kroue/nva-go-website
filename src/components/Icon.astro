  messenger:
    '<path d="M12 2.5C6.5 2.5 2.5 6.4 2.5 11.4c0 2.8 1.3 5.2 3.4 6.8v3.3l3.1-1.7c.9.3 1.9.4 3 .4 5.5 0 9.5-3.9 9.5-8.8S17.5 2.5 12 2.5z"/><path d="m7 13.8 3-3.2 2.4 2 3-3.2-3 3.2-2.4-2"/>',
