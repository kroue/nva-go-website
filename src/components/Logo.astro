---
/**
 * Official NVA Printing Services logo (src/assets/logo-transparent.png, trimmed with a
 * transparent background). On dark backgrounds it sits on a white chip, because the
 * "PRINTING SERVICES" wordmark is black.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-transparent.png';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  tone?: 'ink' | 'paper';
  alt?: string;
  eager?: boolean;
}
const { size = 'md', tone = 'ink', alt = 'NVA Printing Services', eager = false } = Astro.props;
// Rendered heights in px; width follows the logo's aspect ratio.
const height = { sm: 46, md: 60, lg: 104 }[size];
const width = Math.round((height * logo.width) / logo.height);
---

<span class:list={['inline-flex shrink-0', tone === 'paper' && 'rounded-card bg-paper px-3 py-2']}>
  <Image
    src={logo}
    alt={alt}
    width={width}
    height={height}
    densities={[1, 2]}
    quality={85}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`width:${width}px;height:${height}px`}
    class="max-w-none"
  />
</span>
