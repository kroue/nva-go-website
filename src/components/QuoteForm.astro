---
/**
 * Quote form (variant="quote") and corporate bulk inquiry form (variant="bulk").
 * Works without JavaScript (plain POST to /api/quote). With JS it validates files,
 * shows the tarpaulin size helper, pre-selects the product from ?product=<slug>
 * and submits in place.
 */
import { PRICE_PER_SQFT, site } from '../config/site';
import { categories } from '../data/products';
import { bundles, budgetRanges } from '../data/bundles';
import { ACCEPT_ATTR, MAX_FILE_MB } from '../lib/quote-rules';
import Icon from './Icon.astro';
import InkDrop from './InkDrop.astro';

interface Props {
  variant?: 'quote' | 'bulk';
  /** Pre-selected product slug (the script also reads ?product= from the URL). */
  product?: string;
  headingId?: string;
}

const { variant = 'quote', product, headingId } = Astro.props;
const bulk = variant === 'bulk';
const p = bulk ? 'bq' : 'q';
---

<div class="quote-form" data-quote-root>
  <form
    action="/api/quote/"
    method="post"
    enctype="multipart/form-data"
    class="space-y-8"
    data-quote-form
    data-variant={variant}
    data-price-per-sqft={PRICE_PER_SQFT ?? ''}
    aria-labelledby={headingId}
  >
    <input type="hidden" name="form_type" value={variant} />

    <!-- Honeypot: humans never see this field. Bots that fill it are ignored. -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label for={`${p}-website`}>Leave this empty</label>
      <input id={`${p}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="rounded-card border-2 border-magenta-ink bg-magenta-tint p-4 text-[0.95rem]" role="alert" data-error-summary hidden>
      <p class="font-bold">Please check the following:</p>
      <ul class="mt-2 list-disc pl-5" data-error-list></ul>
    </div>

    <!-- ===== What ===== -->
    <fieldset class="space-y-5">
      <legend class="label mb-4 flex items-center gap-2 text-cyan-ink">
        <InkDrop fill="cyan" class="h-4 w-auto" />
        {bulk ? 'Your event or order' : 'What you need'}
      </legend>

      {
        bulk && (
          <div>
            <label for={`${p}-org`} class="field-label">Company, school or organization</label>
            <input id={`${p}-org`} name="organization" type="text" class="input" autocomplete="organization" required />
          </div>
        )
      }

      <div>
        <label for={`${p}-product`} class="field-label">{bulk ? 'Kit or item' : 'Product'}</label>
        <select id={`${p}-product`} name="product" class="input" required data-product-select>
          <option value="" disabled selected={!product}>{bulk ? 'Choose a kit or item' : 'Choose a product'}</option>
          {
            bulk && (
              <optgroup label="Giveaway kits">
                {bundles.map((b) => (
                  <option value={`kit:${b.id}`}>{b.name}</option>
                ))}
                <option value="kit:custom">Custom mix of items</option>
              </optgroup>
            )
          }
          {
            categories.map((c) => (
              <optgroup label={c.name}>
                {c.items.map((item) => (
                  <option value={item.slug} data-large={item.largeFormat ? '' : undefined} selected={item.slug === product}>
                    {item.name}
                  </option>
                ))}
              </optgroup>
            ))
          }
          <option value="other">Something else / not sure</option>
        </select>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for={`${p}-qty`} class="field-label">{bulk ? 'Quantity or number of guests' : 'Quantity'}</label>
          <input id={`${p}-qty`} name="quantity" type="number" inputmode="numeric" min="1" max="1000000" step="1" class="input" required data-qty />
        </div>
        <div>
          <label for={`${p}-deadline`} class="field-label">
            Deadline {!bulk && <span class="font-normal text-grey">(optional)</span>}
          </label>
          <input id={`${p}-deadline`} name="deadline" type="date" class="input" required={bulk} data-deadline />
        </div>
      </div>

      {
        bulk ? (
          <div>
            <label for={`${p}-budget`} class="field-label">Budget range</label>
            <select id={`${p}-budget`} name="budget" class="input" required>
              <option value="" disabled selected>
                Choose a range
              </option>
              {budgetRanges.map((r) => (
                <option>{r}</option>
              ))}
            </select>
            <span class="field-hint">Helps us suggest items that fit. It’s your budget, not our price.</span>
          </div>
        ) : (
          <div class="rounded-card border border-line bg-offwhite p-4 sm:p-5" data-size-helper>
            <p class="field-label mb-0" id={`${p}-size-label`}>
              <span class="inline-flex items-center gap-2"><Icon name="ruler" class="size-4" /> Size in feet</span>
              <span class="block text-sm font-normal text-grey">For tarpaulins and large format. Leave blank for other items.</span>
            </p>
            <div class="mt-3 grid grid-cols-[1fr_auto_1fr] items-end gap-3" role="group" aria-labelledby={`${p}-size-label`}>
              <div>
                <label for={`${p}-w`} class="mb-1 block text-sm font-semibold">Width (ft)</label>
                <input id={`${p}-w`} name="width_ft" type="number" inputmode="decimal" min="0.5" max="200" step="0.5" class="input" data-width />
              </div>
              <span class="pb-3 text-xl font-bold text-grey" aria-hidden="true">×</span>
              <div>
                <label for={`${p}-h`} class="mb-1 block text-sm font-semibold">Height (ft)</label>
                <input id={`${p}-h`} name="height_ft" type="number" inputmode="decimal" min="0.5" max="200" step="0.5" class="input" data-height />
              </div>
            </div>
            <p class="mt-3 min-h-[3rem] text-[0.95rem]" aria-live="polite" data-size-output>
              Enter width and height to see the area in square feet. We’ll send your exact price.
            </p>
          </div>
        )
      }

      <label class="flex cursor-pointer items-start gap-3 rounded-card border-2 border-line p-4 hover:border-ink has-[:checked]:border-ink has-[:checked]:bg-yellow-tint">
        <input type="checkbox" name="rush" value="yes" class="check" data-rush />
        <span>
          <span class="flex items-center gap-1.5 font-bold"><Icon name="bolt" class="size-4" /> Rush order</span>
          <span class="block text-sm text-grey">Need it fast? We’ll confirm if we can meet your date before you pay.</span>
        </span>
      </label>
    </fieldset>

    <!-- ===== Design ===== -->
    <fieldset class="space-y-5">
      <legend class="label mb-4 flex items-center gap-2 text-magenta-ink">
        <InkDrop fill="magenta" class="h-4 w-auto" />
        {bulk ? 'Your logo' : 'Your design'}
      </legend>

      {
        !bulk && (
          <div class="grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label="Design">
            <label class="flex cursor-pointer items-start gap-3 rounded-card border-2 border-line p-4 hover:border-ink has-[:checked]:border-ink has-[:checked]:bg-cyan-tint">
              <input type="radio" name="design" value="have" class="check" required checked />
              <span>
                <span class="block font-bold">I have a design</span>
                <span class="block text-sm text-grey">Upload it below or send it later.</span>
              </span>
            </label>
            <label class="flex cursor-pointer items-start gap-3 rounded-card border-2 border-line p-4 hover:border-ink has-[:checked]:border-ink has-[:checked]:bg-cyan-tint">
              <input type="radio" name="design" value="need" class="check" required />
              <span>
                <span class="block font-bold">I need a design</span>
                <span class="block text-sm text-grey">Our layout artist will make one for you.</span>
              </span>
            </label>
          </div>
        )
      }

      <div>
        <label for={`${p}-file`} class="field-label">
          {bulk ? 'Logo or reference file' : 'Artwork file'} <span class="font-normal text-grey">(optional)</span>
        </label>
        <label
          for={`${p}-file`}
          class="flex cursor-pointer flex-col items-center justify-center gap-1 rounded-card border-2 border-dashed border-[#bdbdb6] bg-paper px-4 py-6 text-center hover:border-ink"
        >
          <Icon name="upload" class="size-6" />
          <span class="font-bold" data-file-name>Choose a file</span>
          <span class="text-sm text-grey">PDF, AI, PSD, PNG or JPG · up to {MAX_FILE_MB} MB</span>
        </label>
        <input id={`${p}-file`} name="artwork" type="file" accept={ACCEPT_ATTR} class="sr-only" data-file aria-describedby={`${p}-file-hint`} />
        <span id={`${p}-file-hint`} class="field-hint" data-file-hint>
          Big file? No problem. You can also send it on <a href={site.social.messenger} class="link" rel="noopener">Messenger</a> after submitting.
        </span>
      </div>
    </fieldset>

    <!-- ===== Contact ===== -->
    <fieldset class="space-y-5">
      <legend class="label mb-4 flex items-center gap-2 text-ink">
        <InkDrop fill="yellow" class="h-4 w-auto" />
        How we reach you
      </legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for={`${p}-name`} class="field-label">Your name</label>
          <input id={`${p}-name`} name="name" type="text" class="input" autocomplete="name" required maxlength="120" />
        </div>
        <div>
          <label for={`${p}-mobile`} class="field-label">Mobile number</label>
          <input
            id={`${p}-mobile`}
            name="mobile"
            type="tel"
            inputmode="tel"
            class="input"
            autocomplete="tel-national"
            placeholder="09XXXXXXXXX"
            pattern="(\+?63|0)?\s?9[0-9\s\-]{9,13}"
            required
            data-mobile
            aria-describedby={`${p}-mobile-hint`}
          />
          <span id={`${p}-mobile-hint`} class="field-hint">11 digits, starting with 09</span>
        </div>
        <div>
          <label for={`${p}-email`} class="field-label">Email <span class="font-normal text-grey">{bulk ? '' : '(optional)'}</span></label>
          <input id={`${p}-email`} name="email" type="email" class="input" autocomplete="email" required={bulk} maxlength="160" />
        </div>
        <div class="sm:col-span-2">
          <label for={`${p}-notes`} class="field-label">Notes <span class="font-normal text-grey">(optional)</span></label>
          <textarea
            id={`${p}-notes`}
            name="notes"
            rows="4"
            maxlength="2000"
            class="input min-h-28"
            placeholder={bulk ? 'Event date, items you have in mind, colors, delivery location…' : 'Text to print, colors, finishing, pick-up or delivery…'}
          ></textarea>
        </div>
      </div>
    </fieldset>

    <label class="flex items-start gap-3 text-[0.95rem]">
      <input type="checkbox" name="consent" value="yes" class="check" required />
      <span>
        I agree that NVA Printing Services may use my details to reply to this {bulk ? 'inquiry' : 'quote request'}, in line with the
        Data Privacy Act of 2012 and the <a href="/privacy/" class="link">Privacy Policy</a>.
      </span>
    </label>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>
        <Icon name="arrow" />
        <span data-submit-label>{bulk ? 'Send bulk inquiry' : 'Send quote request'}</span>
      </button>
      <p class="text-sm text-grey">Free, no commitment. We reply during shop hours.</p>
    </div>
  </form>

  <div class="crop-marks rounded-card border border-line bg-paper p-6 sm:p-10" data-success tabindex="-1" hidden>
    <span class="grid size-14 place-items-center rounded-full bg-cyan text-ink"><Icon name="check" class="size-7" /></span>
    <h3 class="h3 mt-5" data-success-title>Salamat! We got your request.</h3>
    <p class="mt-3 text-lg text-grey" data-success-text>
      We’ll get back to you by text, call or email during shop hours ({site.hoursShort}).
    </p>
    <p class="mt-4 rounded-card bg-yellow-tint p-4 text-[0.95rem]" data-demo-note hidden>
      This is a preview of the website, so no message was sent yet. Your details were checked but not stored.
    </p>
    <div class="mt-6 flex flex-col gap-3 xs:flex-row xs:flex-wrap">
      <a href={site.social.messenger} class="btn btn-messenger" rel="noopener"><Icon name="messenger" /> Send your file on Messenger</a>
      <a href="/products/" class="btn btn-outline">Browse products</a>
    </div>
  </div>
</div>

<script>
  import { initQuoteForms } from '../scripts/quote-form';
  initQuoteForms();
</script>
