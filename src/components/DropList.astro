---
/** Bullet list with ink-drop markers. Pass items as an array of strings. */
import type { Accent } from '../data/products';
import InkDrop from './InkDrop.astro';

interface Props {
  items: string[];
  accent?: Accent | 'paper';
  class?: string;
}
const { items, accent = 'cyan', class: className = 'space-y-2.5' } = Astro.props;
---

<ul class={className}>
  {
    items.map((item) => (
      <li class="flex gap-3">
        <InkDrop fill={accent} class="mt-[0.3em] h-[1.05em] w-auto shrink-0" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
