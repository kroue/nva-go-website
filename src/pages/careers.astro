---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { jobs } from '../data/jobs';
import { photos } from '../data/images';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import DropList from '../components/DropList.astro';
import SectionHeading from '../components/SectionHeading.astro';

const crumbs = [{ name: 'Careers', path: '/careers/' }];
const applyHref = (title?: string) =>
  `mailto:${site.hrEmail}?subject=${encodeURIComponent(title ? `Application: ${title}` : 'Application: General / CV on file')}`;
---

<Base
  title="Careers: Work at Our Divisoria Print Shop"
  description="Work at NVA Printing Services in Divisoria, Cagayan de Oro. See current openings for print, layout and customer service roles, or send your CV."
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} label="Careers" title="Print things people are proud of." accent="yellow">
    We’re a busy Divisoria print shop that serves walk-in customers, small businesses, schools and companies all over CDO. If you like
    making things, fixing problems and seeing your work out in the city, you’ll fit right in.
  </PageHero>

  <section class="py-14 sm:py-20" aria-labelledby="life-title">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading id="life-title" label="Working at NVA" title="What it’s like here." accent="yellow" />
        <DropList
          class="mt-6 space-y-3 text-[1.0625rem]"
          accent="yellow"
          items={[
            'Hands-on work: layout, printing, finishing and customer service, all under one roof',
            'You learn the trade: machines, materials and what makes a print look good',
            'A central location in Divisoria, easy to reach by jeep',
            'A team that pulls together on rush jobs, and says salamat when it’s done',
          ]}
        />
      </div>
      <div class="crop-marks">
        <Photo photo={photos.pressRoom} ratio="4 / 3" accent="yellow" label="The print floor" sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-offwhite py-14 sm:py-20" aria-labelledby="open-title">
    <div class="container-x">
      <SectionHeading id="open-title" label="Openings" title="Current openings" accent="yellow" />
      {
        jobs.length > 0 ? (
          <ul class="mt-10 grid gap-6 md:grid-cols-2">
            {jobs.map((job) => (
              <li class="card flex flex-col p-6 sm:p-7">
                <p class="label text-grey">{job.type}</p>
                <h3 class="h3 mt-1">{job.title}</h3>
                <p class="mt-3 text-grey">{job.summary}</p>
                <DropList class="mt-4 space-y-1.5 text-[0.95rem]" accent="yellow" items={job.requirements} />
                <a href={applyHref(job.title)} class="btn btn-primary mt-6 w-fit">
                  <Icon name="mail" /> Apply by email
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="crop-marks mt-10 max-w-2xl rounded-card border border-line bg-paper p-7 sm:p-9">
            <span class="grid size-12 place-items-center rounded-full bg-yellow"><Icon name="briefcase" class="size-6" /></span>
            <h3 class="h3 mt-5">No openings right now, send your CV anyway.</h3>
            <p class="mt-3 text-grey">
              We keep good applications on file and reach out when a spot opens up in layout, production or the front counter.
            </p>
            <a href={applyHref()} class="btn btn-primary mt-6">
              <Icon name="mail" /> Email your CV
            </a>
          </div>
        )
      }
      <p class="mt-8 text-grey">
        Send your CV to <a href={applyHref()} class="link break-all text-ink">{site.hrEmail}</a> with the position in the subject line.
      </p>
    </div>
  </section>
</Base>
