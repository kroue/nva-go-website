---
/** Confirmation page for browsers without JavaScript (the form redirects here). */
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import Icon from '../../components/Icon.astro';
---

<Base title="Quote Request Sent" description="Your quote request was received by NVA Printing Services." noindex>
  <section class="py-20">
    <div class="container-x max-w-2xl">
      <div class="crop-marks rounded-card border border-line p-8 sm:p-10">
        <span class="grid size-14 place-items-center rounded-full bg-cyan"><Icon name="check" class="size-7" /></span>
        <h1 class="h2 mt-6">Salamat! We got your request.</h1>
        <p class="mt-4 text-lg text-grey">
          We’ll get back to you by text, call or email during shop hours ({site.hoursShort}).
          <span data-ref></span>
        </p>
        <p class="mt-4 rounded-card bg-yellow-tint p-4" data-demo hidden>
          This is a preview of the website, so no message was sent yet. Your details were checked but not stored.
        </p>
        <div class="mt-8 flex flex-col gap-3 xs:flex-row xs:flex-wrap">
          <a href={site.social.messenger} class="btn btn-messenger" rel="noopener"><Icon name="messenger" /> Send your file on Messenger</a>
          <a href="/" class="btn btn-outline">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const q = new URLSearchParams(location.search);
  const ref = q.get('ref');
  const refEl = document.querySelector('[data-ref]');
  if (ref && refEl) refEl.textContent = ` Your reference: ${ref}.`;
  const demo = document.querySelector<HTMLElement>('[data-demo]');
  if (demo && q.get('demo') === '1') demo.hidden = false;
</script>
