---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { localBusiness } from '../lib/schema';
import PageHero from '../components/PageHero.astro';
import ShopInfo from '../components/ShopInfo.astro';
import Icon from '../components/Icon.astro';

const crumbs = [{ name: 'Contact', path: '/contact/' }];

const channels = [
  { icon: 'messenger', title: 'Messenger', text: 'Quickest for quotes and sending files.', href: site.social.messenger, cta: 'Message us', tone: 'bg-cyan-tint' },
  { icon: 'phone', title: 'Call or text', text: site.phone.mobile.label, href: `tel:${site.phone.mobile.tel}`, cta: 'Call now', tone: 'bg-yellow-tint' },
  { icon: 'mail', title: 'Email', text: site.email, href: `mailto:${site.email}`, cta: 'Send an email', tone: 'bg-magenta-tint' },
] as const;
---

<Base
  title="Contact & Directions: Divisoria Printing Shop"
  description="Visit NVA Printing Services on Pabayo-Chavez Sts., beside Greenwich Divisoria, in front of LBC, Cagayan de Oro. Open Monday to Saturday, 8:30 AM to 5:30 PM. Call 0917 717 7429."
  crumbs={crumbs}
  jsonLd={[localBusiness()]}
>
  <PageHero crumbs={crumbs} label="Contact" title="Maayong adlaw! How can we help?" accent="magenta">
    Message, call, email or walk in. We’re right in the middle of Divisoria.
  </PageHero>

  <section class="py-12 sm:py-16" aria-label="Ways to reach us">
    <div class="container-x">
      <ul class="grid gap-5 md:grid-cols-3">
        {
          channels.map((c) => (
            <li>
              <a href={c.href} rel="noopener" class="card group flex h-full flex-col p-6 hover:border-ink">
                <span class:list={['grid size-12 place-items-center rounded-full', c.tone]}>
                  <Icon name={c.icon} class="size-6" />
                </span>
                <h2 class="h3 mt-4">{c.title}</h2>
                <p class="mt-1 break-all text-grey">{c.text}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 font-bold group-hover:underline">
                  {c.cta} <Icon name="arrow" class="size-4" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-offwhite py-14 sm:py-20" aria-label="Visit the shop">
    <div class="container-x">
      <ShopInfo />
    </div>
  </section>

  <section class="py-14" aria-labelledby="more-title">
    <div class="container-x flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 id="more-title" class="h3">Ready with your order?</h2>
        <p class="mt-1 text-grey">Skip the back-and-forth. Send the details and we’ll reply with a price.</p>
      </div>
      <div class="flex flex-col gap-3 xs:flex-row">
        <a href="/quote/" class="btn btn-primary"><Icon name="quote" /> Get a Quote</a>
        <a href="/careers/" class="btn btn-outline"><Icon name="briefcase" /> Careers</a>
      </div>
    </div>
  </section>
</Base>
