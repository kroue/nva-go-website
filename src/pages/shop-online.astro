---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import DropList from '../components/DropList.astro';

const crumbs = [{ name: 'Shop Online', path: '/shop-online/' }];

const stores = [
  {
    name: 'Shopee',
    href: site.stores.shopee,
    text: 'Browse our Shopee store and check out with the vouchers and payment options you already use.',
    bg: 'bg-[#EE4D2D]',
  },
  {
    name: 'Lazada',
    href: site.stores.lazada,
    text: 'Browse our Lazada store and pay the way you’re used to, delivered to your door.',
    bg: 'bg-[#0F146D]',
  },
];
---

<Base
  title="Shop NVA Printing on Shopee & Lazada"
  description="Buy from NVA Printing Services on Shopee and Lazada. Official store links for our Cagayan de Oro print shop."
  crumbs={crumbs}
>
  <PageHero crumbs={crumbs} label="Shop online" title="Find us on Shopee and Lazada." accent="cyan">
    Prefer to check out on the apps you already use? Our official stores are one tap away.
  </PageHero>

  <section class="py-14 sm:py-20" aria-label="Our online stores">
    <div class="container-x grid gap-8 md:grid-cols-2">
      {
        stores.map((s) => (
          <a href={s.href} rel="noopener" class="card crop-marks group flex flex-col overflow-hidden hover:border-ink">
            <div class:list={['flex h-32 items-center px-7 text-white', s.bg]}>
              <span class="font-display text-4xl">{s.name}</span>
              <Icon name="bag" class="ml-auto size-10 opacity-80" />
            </div>
            <div class="flex flex-1 flex-col p-7">
              <p class="text-lg text-grey">{s.text}</p>
              <span class="btn btn-primary mt-6 w-fit">
                Visit our {s.name} store <Icon name="external" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-offwhite py-14" aria-labelledby="custom-title">
    <div class="container-x grid items-center gap-8 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 id="custom-title" class="h2">Need something custom?</h2>
        <p class="mt-3 text-lg text-grey">
          Big tarps, bulk giveaways and anything with your own design are easier to arrange directly with us.
        </p>
        <DropList class="mt-5 space-y-2" items={['Exact sizes and quantities', 'Layout help from our artist', 'Rush jobs and bulk pricing']} />
      </div>
      <div class="flex flex-col gap-3">
        <a href="/quote/" class="btn btn-primary"><Icon name="quote" /> Get a Quote</a>
        <a href={site.social.messenger} class="btn btn-messenger" rel="noopener"><Icon name="messenger" /> Message us on Messenger</a>
      </div>
    </div>
  </section>
</Base>
