# Quote form email delivery (Resend — https://resend.com)
# Leave these empty to run the quote form in demo mode (shows a success message, sends nothing).
RESEND_API_KEY=
# Where quote and bulk inquiries are delivered
QUOTE_TO_EMAIL=nvaprintingservices@gmail.com
# Sender address. Must be on a domain verified in Resend (e.g. quotes@nvaprinting.com).
# If empty, Resend's test sender (onboarding@resend.dev) is used, which only delivers to your own Resend account email.
QUOTE_FROM_EMAIL=
